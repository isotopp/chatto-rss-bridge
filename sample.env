# Sample configuration. Copy to .env or ~/.chatto-rss-bridge.env and edit.
#
# Create a Chatto bot, copy its one-time API key, and replace this value.
BOT_API_KEY=replace-with-the-bot-api-key
# Replace with the stable ID of the destination room.
BOT_ROOM_ID=replace-with-the-room-id
# Who can give the bot commands?
BOT_BRIDGE_ROLE=rss-bot-operator
# Use the bare Chatto server origin, without /api or another path.
CHATTO_BASE_URL=https://chatto.example
